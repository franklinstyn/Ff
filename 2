
import os
import duckdb
import pgeocode
import pandas as pd
import numpy as np

from sqlalchemy import create_engine
from sklearn.cluster import DBSCAN
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import silhouette_score
from google.cloud import storage


# ==========================================
# CONFIGURATION
# ==========================================

DB_USER = os.getenv("DB_USER", "root")
DB_PASSWORD = os.getenv("DB_PASSWORD", "root")
DB_HOST = os.getenv("DB_HOST", "localhost")
DB_PORT = os.getenv("DB_PORT", "3306")
DB_NAME = os.getenv("DB_NAME", "multifamily")

GCS_BUCKET = "bbi-scraped-items-new"

OUTPUT_DIR = "output"

os.makedirs(OUTPUT_DIR, exist_ok=True)


# ==========================================
# DATABASE MANAGER
# ==========================================

class DatabaseManager:

    def __init__(self):
        self.engine = create_engine(
            f"mysql+pymysql://{DB_USER}:{DB_PASSWORD}@"
            f"{DB_HOST}:{DB_PORT}/{DB_NAME}"
        )

        self.conn = None

    def get_homes(self):
        query = """
        SELECT id, zip, longitude, latitude
        FROM tricon_american_homes
        """

        return pd.read_sql(query, self.engine)

    def save_clusters(self, df):
        df = df.rename(columns={"id": "home_id"})

        df.to_sql(
            "home_clusters",
            self.engine,
            index=False,
            if_exists="replace",
            method="multi"
        )

    def connect_duckdb(self):
        self.conn = duckdb.connect()

        self.conn.execute("INSTALL mysql")
        self.conn.execute("LOAD mysql")

        mysql_connection = (
            f"host={DB_HOST} "
            f"user={DB_USER} "
            f"password={DB_PASSWORD} "
            f"port={DB_PORT} "
            f"database={DB_NAME}"
        )

        self.conn.execute(
            f"ATTACH '{mysql_connection}' AS mysqldb (TYPE mysql)"
        )

        return self.conn

    def close(self):
        if self.conn:
            self.conn.close()

        self.engine.dispose()


# ==========================================
# GCS MANAGER
# ==========================================

class GCSManager:

    def __init__(self, bucket_name):
        self.client = storage.Client()
        self.bucket = self.client.bucket(bucket_name)

    def upload_file(self, file_path):

        file_name = os.path.basename(file_path)

        blob = self.bucket.blob(file_name)

        blob.upload_from_filename(file_path)

        print(f"Uploaded to GCS: {file_name}")


# ==========================================
# CLUSTER PROCESSOR
# ==========================================

class ClusterProcessor:

    def __init__(self, database):
        self.database = database

    def correct_coordinates(self, df):

        df["longitude"] = pd.to_numeric(
            df["longitude"], errors="coerce"
        )

        df["latitude"] = pd.to_numeric(
            df["latitude"], errors="coerce"
        )

        valid = df[
            ["longitude", "latitude"]
        ].notna().all(axis=1)

        labels = pd.Series(-1, index=df.index)

        if valid.sum() >= 3:

            scaler = StandardScaler()

            X = scaler.fit_transform(
                df.loc[valid, ["longitude", "latitude"]]
            )

            model = DBSCAN(
                eps=0.5,
                min_samples=3
            )

            labels.loc[valid] = model.fit_predict(X)

        outliers = df[labels == -1]

        zip_codes = (
            outliers["zip"]
            .astype(str)
            .str.extract(r"(\d{5})")[0]
        )

        nomi = pgeocode.Nominatim("us")

        coordinates = nomi.query_postal_code(
            zip_codes.tolist()
        )

        valid_coordinates = (
            coordinates["latitude"].notna()
            & coordinates["longitude"].notna()
        )

        valid_indices = outliers.index[valid_coordinates]

        df.loc[valid_indices, "latitude"] = (
            coordinates.loc[valid_coordinates, "latitude"].values
        )

        df.loc[valid_indices, "longitude"] = (
            coordinates.loc[valid_coordinates, "longitude"].values
        )

        return df

    def apply_dbscan(self, df):

        valid = df[
            ["longitude", "latitude"]
        ].notna().all(axis=1)

        labels = pd.Series(-1, index=df.index)

        X = np.radians(
            df.loc[valid, ["longitude", "latitude"]].values
        )

        model = DBSCAN(
            eps=10 / 6371.0088,
            min_samples=1,
            algorithm="ball_tree",
            metric="haversine"
        )

        labels.loc[valid] = model.fit_predict(X)

        df["cluster"] = labels.astype(int)

        cluster_count = df.loc[
            df["cluster"] != -1, "cluster"
        ].nunique()

        print("Total homes:", len(df))
        print("Number of clusters:", cluster_count)
        print("Number of outliers:", (df["cluster"] == -1).sum())

        if 2 <= cluster_count <= len(X) - 1:
            score = silhouette_score(
                X,
                labels.loc[valid],
                metric="haversine",
                sample_size=min(10000, len(X)),
                random_state=42
            )

            print("Silhouette Score:", score)

        else:
            print("Silhouette score cannot be calculated.")

        return df

    def process(self):

        df = self.database.get_homes()

        df = self.correct_coordinates(df)

        df = self.apply_dbscan(df)

        self.database.save_clusters(df)

        print("Home clusters saved to MySQL.")

        return df


# ==========================================
# PRICE PROCESSOR
# ==========================================

class PriceProcessor:

    def __init__(self, conn, gcs):
        self.conn = conn
        self.gcs = gcs

    def export_parquet(self, query, file_path):

        self.conn.execute(
            f"""
            COPY ({query})
            TO '{file_path}'
            (FORMAT PARQUET, COMPRESSION ZSTD)
            """
        )

        self.gcs.upload_file(file_path)

        print("Parquet created and uploaded:", file_path)

    def create_processing_table(self):

        query = """
        SELECT
            p._homeId,
            CAST(p.price AS DOUBLE) AS price,
            p.term,
            p.createdDate,
            h.cluster,
            h.longitude,
            h.latitude

        FROM mysqldb.tricon_american_homes_pricing p

        INNER JOIN mysqldb.home_clusters h
            ON p._homeId = h.home_id

        WHERE p._homeId IS NOT NULL
        """

        self.conn.execute(
            f"""
            COPY ({query})
            TO '{OUTPUT_DIR}/1_processing_table.csv'
            (FORMAT CSV, HEADER)
            """
        )

        self.export_parquet(
            query,
            f"{OUTPUT_DIR}/1_processing_table.parquet"
        )

    def clean_price_outliers(self):

        self.conn.execute("""
        CREATE OR REPLACE TEMP TABLE aggregate_by_term AS

        SELECT
            _homeId,
            cluster,
            AVG(price) AS avg_term_price,
            createdDate,
            ANY_VALUE(longitude) AS longitude,
            ANY_VALUE(latitude) AS latitude

        FROM read_parquet('output/1_processing_table.parquet')

        GROUP BY _homeId, createdDate, cluster
        """)

        self.conn.execute("""
        CREATE OR REPLACE TEMP TABLE cluster_iqr_bounds AS

        SELECT
            cluster,
            QUANTILE_CONT(avg_term_price, 0.25) AS q1,
            QUANTILE_CONT(avg_term_price, 0.75) AS q3,
            q1 - 1.5 * (q3 - q1) AS lower_bound,
            q3 + 1.5 * (q3 - q1) AS upper_bound

        FROM aggregate_by_term

        GROUP BY cluster
        """)

        query = """
        SELECT t.*

        FROM aggregate_by_term t

        INNER JOIN cluster_iqr_bounds q
            ON t.cluster = q.cluster

        WHERE t.avg_term_price >= q.lower_bound
          AND t.avg_term_price <= q.upper_bound
        """

        self.export_parquet(
            query,
            f"{OUTPUT_DIR}/2_cleaned_processing_table.parquet"
        )

    def create_daily_summary(self):

        query = """
        SELECT
            cluster,
            AVG(avg_term_price) AS average_price,
            MEDIAN(avg_term_price) AS median_price,
            COUNT(DISTINCT _homeId) AS cluster_home_count,
            createdDate

        FROM read_parquet(
            'output/2_cleaned_processing_table.parquet'
        )

        GROUP BY createdDate, cluster

        ORDER BY createdDate, cluster
        """

        self.export_parquet(
            query,
            f"{OUTPUT_DIR}/3_cluster_daily_summary.parquet"
        )


# ==========================================
# TREND ANALYZER
# ==========================================

class TrendAnalyzer:

    def __init__(self, conn, gcs):
        self.conn = conn
        self.gcs = gcs

    def analyze_trends(self):

        self.conn.execute("""
        CREATE OR REPLACE TEMP TABLE cluster_trends AS

        SELECT
            *,

            LAG(average_price) OVER (
                PARTITION BY cluster
                ORDER BY createdDate
            ) AS previous_avg_price,

            AVG(average_price) OVER (
                PARTITION BY cluster
                ORDER BY createdDate
                ROWS BETWEEN 6 PRECEDING AND CURRENT ROW
            ) AS moving_avg_7,

            AVG(average_price) OVER (
                PARTITION BY cluster
                ORDER BY createdDate
                ROWS BETWEEN 29 PRECEDING AND CURRENT ROW
            ) AS moving_avg_30,

            STDDEV(average_price) OVER (
                PARTITION BY cluster
                ORDER BY createdDate
                ROWS BETWEEN 6 PRECEDING AND CURRENT ROW
            ) AS price_volatility_7

        FROM read_parquet(
            'output/3_cluster_daily_summary.parquet'
        )
        """)

        query = """
        SELECT
            *,

            CASE
                WHEN previous_avg_price IS NOT NULL
                 AND previous_avg_price != 0

                THEN (
                    (average_price - previous_avg_price)
                    / previous_avg_price
                ) * 100

            END AS daily_change_pct,

            CASE
                WHEN moving_avg_7 > moving_avg_30
                    THEN 'Upward'

                WHEN moving_avg_7 < moving_avg_30
                    THEN 'Downward'

                ELSE 'Stable'

            END AS trend_direction

        FROM cluster_trends
        """

        file_path = f"{OUTPUT_DIR}/4_trend_analysis.parquet"

        self.conn.execute(
            f"""
            COPY ({query})
            TO '{file_path}'
            (FORMAT PARQUET, COMPRESSION ZSTD)
            """
        )

        self.gcs.upload_file(file_path)

        print("Trend analysis completed and uploaded.")


# ==========================================
# MAIN PIPELINE
# ==========================================

class AnalysisPipeline:

    def __init__(self):

        self.database = DatabaseManager()

        self.gcs = GCSManager(GCS_BUCKET)

    def run(self):

        try:

            print("Starting analysis pipeline...")

            # Step 1: Home clustering

            cluster_processor = ClusterProcessor(
                self.database
            )

            cluster_processor.process()

            # Step 2: DuckDB connection

            conn = self.database.connect_duckdb()

            # Step 3: Price processing

            price_processor = PriceProcessor(
                conn,
                self.gcs
            )

            price_processor.create_processing_table()

            price_processor.clean_price_outliers()

            price_processor.create_daily_summary()

            # Step 4: Trend analysis

            trend_analyzer = TrendAnalyzer(
                conn,
                self.gcs
            )

            trend_analyzer.analyze_trends()

            print("Analysis pipeline completed successfully.")

        finally:

            self.database.close()


# ==========================================
# EXECUTION
# ==========================================

if __name__ == "__main__":

    pipeline = AnalysisPipeline()

    pipeline.run()
