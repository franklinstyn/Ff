
import duckdb
import os

os.makedirs("output/temp", exist_ok=True)

con = duckdb.connect("home_analysis.duckdb")

con.execute("SET memory_limit = '4GB'")
con.execute("SET temp_directory = 'output/temp'")

input_file = "output/home_prices_joined.parquet"

REMOVE_ALL_GLOBAL_OUTLIERS = False

bounds = con.execute(f"""
    SELECT
        QUANTILE_CONT(price, 0.25) AS q1,
        QUANTILE_CONT(price, 0.75) AS q3
    FROM read_parquet('{input_file}')
    WHERE price IS NOT NULL
""").fetchone()

q1 = bounds[0]
q3 = bounds[1]

iqr = q3 - q1
lower_bound = q1 - 1.5 * iqr
upper_bound = q3 + 1.5 * iqr

print("Global Q1:", q1)
print("Global Q3:", q3)
print("Global IQR:", iqr)
print("Lower bound:", lower_bound)
print("Upper bound:", upper_bound)

con.execute(f"""
    COPY (
        SELECT *
        FROM read_parquet('{input_file}')
        WHERE price IS NOT NULL
          AND (
              price < {lower_bound}
              OR price > {upper_bound}
          )
    )
    TO 'output/global_price_outliers.parquet'
    (FORMAT PARQUET, COMPRESSION ZSTD)
""")

outlier_count = con.execute("""
    SELECT COUNT(*)
    FROM read_parquet('output/global_price_outliers.parquet')
""").fetchone()[0]

print("Global price outlier records:", outlier_count)

if REMOVE_ALL_GLOBAL_OUTLIERS:
    price_filter = f"""
        price IS NOT NULL
        AND price >= {lower_bound}
        AND price <= {upper_bound}
    """
else:
    price_filter = "price IS NOT NULL"

con.execute(f"""
    COPY (
        SELECT *
        FROM read_parquet('{input_file}')
        WHERE {price_filter}
    )
    TO 'output/home_prices_for_analysis.parquet'
    (FORMAT PARQUET, COMPRESSION ZSTD)
""")

print("Analysis dataset saved.")

con.execute("""
    COPY (
        SELECT
            cluster_id,
            CAST(createdDate AS DATE) AS createdDate,
            AVG(price) AS avg_price,
            MEDIAN(price) AS median_price,
            COUNT(price) AS price_record_count,
            COUNT(DISTINCT home_id) AS home_count
        FROM read_parquet('output/home_prices_for_analysis.parquet')
        GROUP BY
            cluster_id,
            CAST(createdDate AS DATE)
    )
    TO 'output/cluster_daily_summary.parquet'
    (FORMAT PARQUET, COMPRESSION ZSTD)
""")

print("Daily cluster summary saved.")

con.execute("""
    CREATE OR REPLACE TEMP TABLE cluster_iqr AS
    SELECT
        cluster_id,
        QUANTILE_CONT(avg_price, 0.25) AS q1,
        QUANTILE_CONT(avg_price, 0.75) AS q3
    FROM read_parquet('output/cluster_daily_summary.parquet')
    GROUP BY cluster_id
""")

con.execute("""
    CREATE OR REPLACE TEMP TABLE cluster_iqr_bounds AS
    SELECT
        cluster_id,
        q1,
        q3,
        q1 - 1.5 * (q3 - q1) AS lower_bound,
        q3 + 1.5 * (q3 - q1) AS upper_bound
    FROM cluster_iqr
""")

con.execute("""
    COPY (
        SELECT
            d.cluster_id,
            d.createdDate,
            d.avg_price,
            d.median_price,
            d.price_record_count,
            d.home_count,
            b.q1,
            b.q3,
            b.lower_bound,
            b.upper_bound,
            CASE
                WHEN d.avg_price < b.lower_bound
                    THEN 'Low outlier'
                WHEN d.avg_price > b.upper_bound
                    THEN 'High outlier'
            END AS outlier_type
        FROM read_parquet('output/cluster_daily_summary.parquet') d
        INNER JOIN cluster_iqr_bounds b
            ON d.cluster_id = b.cluster_id
        WHERE d.avg_price < b.lower_bound
           OR d.avg_price > b.upper_bound
    )
    TO 'output/cluster_daily_outliers.parquet'
    (FORMAT PARQUET, COMPRESSION ZSTD)
""")

print("Cluster time-series outliers saved.")

print("\nGlobal outlier examples:")
print(con.execute("""
    SELECT *
    FROM read_parquet('output/global_price_outliers.parquet')
    ORDER BY price DESC
    LIMIT 10
""").fetchdf())

print("\nHighest cluster-date price averages:")
print(con.execute("""
    SELECT *
    FROM read_parquet('output/cluster_daily_outliers.parquet')
    ORDER BY avg_price DESC
    LIMIT 20
""").fetchdf())

print("\nOutlier summary:")
print(con.execute("""
    SELECT
        COUNT(*) AS outlier_cluster_days,
        COUNT(DISTINCT cluster_id) AS affected_clusters,
        MIN(createdDate) AS first_outlier_date,
        MAX(createdDate) AS last_outlier_date
    FROM read_parquet('output/cluster_daily_outliers.parquet')
""").fetchdf())

con.close()
